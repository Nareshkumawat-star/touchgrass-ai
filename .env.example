# ---------------------------------------------------------------------------
# TouchGrass AI — environment variables
#
# Copy to `.env.local` and adjust. Every value below is optional: with an empty
# file the app runs on the local JSON store and the offline mission templates.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AI — local (default, open weights on your own machine)
# ---------------------------------------------------------------------------
# Where Ollama is listening.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Text model used for mission generation.
#   qwen2.5:1.5b  Apache-2.0                                  (default, fast on CPU)
#   qwen2.5:7b    Apache-2.0                                  (best quality, wants a GPU)
#   qwen2.5:3b    Qwen Research License — NON-COMMERCIAL      (see docs)
# Any other chat model in your Ollama library also works.
OLLAMA_MODEL=qwen2.5:1.5b

# Vision model used for discovery identification.
#   qwen2.5vl:3b  Apache-2.0 (default)   qwen2.5vl:7b  Apache-2.0
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Sampling temperature for mission writing.
OLLAMA_TEMPERATURE=0.75

# Hard timeout for a single text request, in milliseconds.
OLLAMA_TIMEOUT_MS=90000

# Vision needs a longer ceiling: reading a photo with a 3B model on a CPU-only
# machine can take 2+ minutes. Too short a value would look like "no vision
# model available".
OLLAMA_VISION_TIMEOUT_MS=240000

# How long Ollama keeps the model loaded between requests (faster follow-ups).
OLLAMA_KEEP_ALIVE=10m

# ---------------------------------------------------------------------------
# AI — provider priority
# ---------------------------------------------------------------------------
# Comma-separated. The first available provider answers.
#   local       — Ollama on this machine (default)
#   huggingface — remote open-weight models (needs a token)
#   heuristic   — reviewed offline templates, always available, always last
AI_PROVIDER_ORDER=local,huggingface,heuristic

# ---------------------------------------------------------------------------
# AI — remote (OPTIONAL, off by default)
# ---------------------------------------------------------------------------
# Set both of these to enable the remote provider. Only then are prompts and
# photos sent to a third party — the app will not do it silently.
# HUGGINGFACE_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
HUGGINGFACE_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Set MONGODB_URI to persist in MongoDB (Mongoose models live in
# src/lib/db/models.ts). Leave it empty to use the built-in local JSON store at
# .touchgrass-data/db.json, which is what makes offline-friendly local demos
# work with zero setup. The app always reports which one is active.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB=touchgrass

# Directory for the fallback store (relative to the project root).
LOCAL_STORE_DIR=.touchgrass-data

# ---------------------------------------------------------------------------
# Sessions and limits
# ---------------------------------------------------------------------------
# Signs the anonymous session cookie. REQUIRED in production: without it the
# development default is used.
SESSION_SECRET=change-me-to-a-long-random-string

# Maximum accepted photo size after client-side downscaling (bytes).
MAX_UPLOAD_BYTES=4194304

# Hard ceiling on a generated mission's duration (minutes).
MAX_MISSION_MINUTES=180
